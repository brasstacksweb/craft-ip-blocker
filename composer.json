{
	"name": "brasstacksweb/craft-ip-blocker",
	"description": "IP address blocker for Craft CMS applications to bock traffic from malicious sources. ",
	"type": "craft-plugin",
	"license": "proprietary",
	"authors": [
		{
			"name": "Brass Tacks Web",
			"homepage": "https://www.brasstacksweb.com"
		}
	],
	"support": {
		"email": "help@brasstacksweb.com",
		"issues": "https://github.com/brasstacksweb/craft-ip-blocker/issues?state=open",
		"source": "https://github.com/brasstacksweb/craft-ip-blocker",
		"docs": "https://github.com/brasstacksweb/craft-ip-blocker",
		"rss": "https://github.com/brasstacksweb/craft-ip-blocker/releases.atom"
	},
	"require": {
		"php": ">=8.2",
		"craftcms/cms": "^5.0"
	},
	"require-dev": {
		"craftcms/phpstan": "dev-main",
		"craftcms/rector": "dev-main"
	},
	"autoload": {
		"psr-4": {
			"brasstacksweb\\craftipblocker\\": "src/"
		}
	},
	"extra": {
		"handle": "craft-ip-blocker",
		"name": "IP Blocker",
		"developer": "Brass Tacks Web",
		"developerUrl": "https://www.brasstacksweb.com",
		"documentationUrl": "https://github.com/brasstacksweb/craft-ip-blocker",
		"class": "brasstacksweb\\craftipblocker\\IPBlocker"
	},
	"scripts": {
		"check-cs": "ecs check --ansi",
		"fix-cs": "ecs check --ansi --fix",
		"phpstan": "phpstan --memory-limit=1G"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.2"
		},
		"allow-plugins": {
			"yiisoft/yii2-composer": true,
			"craftcms/plugin-installer": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
