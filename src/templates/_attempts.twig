{# @var attempts \brasstacksweb\craftipblocker\models\AttemptStats[] #}
{# @var paginator \craft\db\Paginator #}

{% extends 'craft-ip-blocker/_layouts/stats' %}

{% set title = 'IP Blocker Stats - Attempts' %}

{% block content %}
	<section class="readable">
		<h2>Failed Attempts</h2>
		{% if attempts is empty %}
			<p>No attempts found. Add or update conditions in <a href="url('settings/plugins/craft-ip-blocker')" title="Settings">settings</a>.</p>
		{% else %}
			<div class="tableview">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>Pattern</th>
							<th>IP</th>
							<th>First Attempt</th>
							<th>Last Attempt</th>
							<th>Attempts</th>
						</tr>
					</thead>
					<tbody>
						{% for a in attempts %}
							<tr>
								<td>{{ a.pattern }}</td>
								<td>{{ a.ip }}</td>
								<td>{{ a.firstAttempt|date('Y-m-d H:i:s') }}</td>
								<td>{{ a.lastAttempt|date('Y-m-d H:i:s') }}</td>
								<td>{{ a.count }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			{% if paginator.totalResults > 1 %}
				{% include 'craft-ip-blocker/_components/pagination' with {
					baseUrl: url('craft-ip-blocker/attempts'),
					paginator: paginator,
				} only %}
			{% endif %}
		{% endif %}
	</section>
{% endblock %}
