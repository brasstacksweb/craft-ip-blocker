{# @var attempts \brasstacksweb\craftipblocker\records\Attempt[] #}

{% extends 'craft-ip-blocker/_stats' %}

{% set title = 'IP Blocker Stats - Attempts' %}

{% block content %}
	<section class="readable">
		<h2>Failed Attempts</h2>
		{% if attempts is empty %}
			<p>No attempts found.</p>
		{% else %}
			<div class="tableview">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>Pattern</th>
							<th>IP</th>
							<th>First Attempt</th>
							<th>Last Attempt</th>
							<th>Attempts</th>
						</tr>
					</thead>
					<tbody>
						{% for a in attempts %}
							<tr>
								<td>{{ a.pattern }}</td>
								<td>{{ a.ip }}</td>
								<td>{{ a.firstAttempt|date('Y-m-d H:i:s') }}</td>
								<td>{{ a.lastAttempt|date('Y-m-d H:i:s') }}</td>
								<td>{{ a.count }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</section>
{% endblock %}
