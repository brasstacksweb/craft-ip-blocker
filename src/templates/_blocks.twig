{# @var blocks \brasstacksweb\craftipblocker\models\BlockStats[] #}
{# @var paginator \craft\db\Paginator #}

{% extends 'craft-ip-blocker/_layouts/stats' %}

{% set title = 'IP Blocker Stats - Blocks' %}

{% block content %}
	<section class="readable">
		<h2>Blocks</h2>
		{% if blocks is empty %}
			<p>No blocks found. Add or update conditions in <a href="url('settings/plugins/craft-ip-blocker')" title="Settings">settings</a>.</p>
		{% else %}
			<div class="tableview">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>IP</th>
							<th>Reason</th>
							<th>Count</th>
							<th>First Blocked</th>
							<th>Expires</ht>
							<th>Is Active</th>
						</tr>
					</thead>
					<tbody>
						{% for b in blocks %}
							<tr>
								<td>{{ b.ip }}</td>
								<td>{{ b.reason }}</td>
								<td>{{ b.count }}</td>
								<td>{{ b.firstBlocked|date('Y-m-d H:i:s') }}</td>
								<td>{{ b.expires|date('Y-m-d H:i:s') }}</td>
								<td>{{ b.isActive ? 'Yes' : 'No' }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			{% if paginator.totalResults > 1 %}
				{% include 'craft-ip-blocker/_components/pagination' with {
					baseUrl: url('craft-ip-blocker/blocks'),
					paginator: paginator,
				} only %}
			{% endif %}
		{% endif %}
	</section>
{% endblock %}
