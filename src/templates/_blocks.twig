{# @var blocks \brasstacksweb\craftipblocker\models\BlockStats[] #}

{% extends 'craft-ip-blocker/_stats' %}

{% set title = 'IP Blocker Stats - Blocks' %}

{% block content %}
	<section class="readable">
		<h2>Blocks</h2>
		{% if blocks is empty %}
			<p>No blocks found.</p>
		{% else %}
			<div class="tableview">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th>IP</th>
							<th>Reason</th>
							<th>Count</th>
							<th>First Blocked</th>
							<th>Expires</ht>
							<th>Is Active</th>
						</tr>
					</thead>
					<tbody>
						{% for b in blocks %}
							<tr>
								<td>{{ b.ip }}</td>
								<td>{{ b.reason }}</td>
								<td>{{ b.count }}</td>
								<td>{{ b.firstBlocked|date('Y-m-d H:i:s') }}</td>
								<td>{{ b.expires|date('Y-m-d H:i:s') }}</td>
								<td>{{ b.isActive ? 'Yes' : 'No' }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</section>
{% endblock %}
