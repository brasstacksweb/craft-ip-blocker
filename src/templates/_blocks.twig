{# @var blocks \brasstacksweb\craftipblocker\models\BlockStats[] #}
{# @var paginator \craft\db\Paginator #}
{# @var sort string #}
{# @var direction string #}

{% extends 'craft-ip-blocker/_layouts/stats' %}

{% set title = 'IP Blocker Stats - Blocks' %}

{% block content %}
	<section class="readable">
		<h2>Blocks</h2>
		{% if blocks is empty %}
			<p>No blocks found. Add or update conditions in <a href="url('settings/plugins/craft-ip-blocker')" title="Settings">settings</a>.</p>
		{% else %}
			{% include 'craft-ip-blocker/_components/paged-table' with {
				baseUrl: url('craft-ip-blocker/blocks'),
				paginator: paginator,
				columns: blocks|first|keys|map(attr => {
					attribute: attr,
					label: blocks|first.getAttributeLabel(attr),
				}),
				rows: blocks|map(b => b|keys|map(attr => b.getAttributes()[attr])),
				sort: sort,
				direction: direction,
			} only %}
		{% endif %}
	</section>
{% endblock %}
