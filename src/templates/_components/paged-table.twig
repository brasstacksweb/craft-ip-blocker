{##
 # Paged Table component
 # @param {string} baseUrl
 # @param {craft\db\Paginator} paginator
 # @param {object[]} columns
 # |_@param {string} attribute
 # |_@param {string} label
 # @param {string[]} rows
 # @param {string} sort
 # @param {string} direction
 #}

{# Params #}
{% set baseUrl = baseUrl ?? '' %}
{% set paginator = paginator ?? null %}
{% set columns = columns ?? [] %}
{% set rows = rows ?? [] %}
{% set sort = sort ?? '' %}
{% set direction = direction ?? '' %}

{# Variables #}
{% set urlParams = { limit: paginator.pageSize } %}
{% if sort is not empty %}
	{% set urlParams = urlParams|merge({ sort: sort }) %}
{% endif %}
{% if direction is not empty %}
	{% set urlParams = urlParams|merge({ direction: direction }) %}
{% endif %}

{# Markup #}
<div class="paged-table">
	<form method="get" class="flex flex-justify-end" style="margin-bottom: 8px">
		<label for="limit">Results per page:</label>
		<select id="limit" name="limit" class="btn" onchange="this.form.submit()">
			{% for l in [10, 25, 50, 100] %}
				<option value="{{ l }}" {{ l == paginator.pageSize ? 'selected' : '' }}>{{ l }}</option>
			{% endfor %}
		</select>
		<input type="hidden" name="sort" value="{{ sort }}">
		<input type="hidden" name="direction" value="{{ direction }}">
		<input type="hidden" name="page" value="1">
		<noscript><button type="submit" class="btn">Go</button></noscript>
	</form>
	<div class="tableview">
		<table class="data fullwidth">
			<thead>
				<tr>
					{% for c in columns %}
						<th class="orderable {{ c.attribute == sort ? 'ordered ' ~ direction : '' }}">
							<form method="get">
								<input type="hidden" name="sort" value="{{ c.attribute }}">
								<input type="hidden" name="direction" value="{{ c.attribute == sort and direction == 'desc' ? 'asc' : 'desc' }}">
								<input type="hidden" name="page" value="1">
								<input type="hidden" name="limit" value="{{ paginator.pageSize }}">
								<button type="submit">
									<span>{{ c.label }}</span>
								</button>
							</form>
						</th>
					{% endfor %}
				</tr>
			</thead>
			<tbody>
				{% for r in rows %}
					<tr>
						{% for d in r %}
							<td>{{ d }}</td>
						{% endfor %}
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
	<hr />
	<div class="pagination flex flex-nowrap">
		{# First page #}
		{% if paginator.currentPage > 1 %}
			<a
				href="{{ url(baseUrl, urlParams|merge({ page: 1 })) }}"
				class="page-link first" title="First Page">&laquo;</a>
		{% else %}
			<span class="page-link first disabled">&laquo;</span>
		{% endif %}

		{# Previous page #}
		{% if paginator.currentPage > 1 %}
			<a
				href="{{ url(baseUrl, urlParams|merge({ page: paginator.currentPage - 1 })) }}"
				class="page-link prev" title="Previous Page">&larr;</a>
		{% else %}
			<span class="page-link prev disabled">&larr;</span>
		{% endif %}

		{# Calculate range of visible pages #}
		{% set startPage = max(1, paginator.currentPage - 3) %}
		{% set endPage = min(paginator.totalPages, paginator.currentPage + 3) %}

		{# Show ellipsis if needed at beginning #}
		{% if startPage > 1 %}
			<span class="page-link ellipsis disabled">...</span>
		{% endif %}

		{# Pages #}
		{% for p in startPage..endPage %}
			{% if p == paginator.currentPage %}
				<span class="page-link active disabled">{{ p }}</span>
			{% else %}
				<a href="{{ url(baseUrl, urlParams|merge({ page: p })) }}" class="page-link">{{ p }}</a>
			{% endif %}
		{% endfor %}

		{# Show ellipsis if needed at end #}
		{% if endPage < paginator.totalPages %}
			<span class="page-link ellipsis disabled">...</span>
		{% endif %}

		{# Next page #}
		{% if paginator.currentPage < paginator.totalPages %}
			<a
				href="{{ url(baseUrl, urlParams|merge({ page: paginator.currentPage + 1 })) }}"
				class="page-link next" title="Next Page">&rarr;</a>
		{% else %}
			<span class="page-link next disabled">&rarr;</span>
		{% endif %}

		{# Last page #}
		{% if paginator.currentPage < paginator.totalPages %}
			<a
				href="{{ url(baseUrl, urlParams|merge({ page: paginator.totalPages })) }}"
				class="page-link last" title="Last Page">&raquo;</a>
		{% else %}
			<span class="page-link last disabled">&raquo;</span>
		{% endif %}
	</div>
</div>
