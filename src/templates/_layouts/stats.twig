{% set links = [
	{ url: url('craft-ip-blocker/blocks'), label: 'Blocks' },
	{ url: url('craft-ip-blocker/attempts'), label: 'Failed Attempts' },
	{ url: url('settings/plugins/craft-ip-blocker'), label: 'Settings' },
] %}

{% extends '_layouts/cp' %}

{% block header %}
	<h1>Security Stats</h1>
{% endblock %}

{% block sidebar %}
	<nav>
		<ul>
			{% for l in links %}
				<li>
					<a
						href="{{ l.url }}"
						class="{% if craft.app.request.pathInfo in l.url %}sel{% endif %}">
						{{ l.label }}
					</a>
				</li>
			{% endfor %}
		</ul>
	</nav>
{% endblock %}
