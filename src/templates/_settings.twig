{# @var settings \brasstacksweb\craftipblocker\models\Settings #}

{% set condition = create('brasstacksweb\\craftipblocker\\models\\Condition') %}
{% set cols = {} %}
{% for name, _ in condition %}
	{% set cols = cols|merge({
		(name): {
			type: condition.getAttributeType(name),
			heading: condition.getAttributeLabel(name),
			placeholder: condition.getAttributePlaceholder(name),
			info: condition.getAttributeHint(name),
			width: condition.getAttributeWidth(name),
		},
	}) %}
{% endfor %}
{% set rows = settings.conditions|map(c => {
	pattern: c.pattern,
	maxAttempts: c.maxAttempts,
	blockTime: c.blockTime,
	detectionWindow: c.detectionWindow,
}) %}

{% import "_includes/forms" as forms %}

{% block content %}
	<input type="hidden" name="action" value="">
	{{ actionInput("craft-ip-blocker/settings/save") }}
	{{ redirectInput("settings/plugins/craft-ip-blocker") }}

	{{ forms.editableTableField({
		label: 'Block Conditions',
		id: 'conditions',
		name: 'conditions',
		cols: cols,
		rows: rows,
		allowAdd: true,
		addRowLabel: 'Add a Condition',
		allowDelete: true,
		allowReorder: true,
		defaultValues: {
			maxAttempts: 5,
			blockTime: 3600,
			detectionWindow: 300,
		},
	}) }}
{% endblock %}
